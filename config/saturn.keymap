#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&msc {
};

&mmv {
};

/ {
    macros {
        layer3light: layerlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 3 &rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(239,100,50)>;
            label = "LAYERLIGHT";
        };

        layer0light: layer0light {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &rgb_ug RGB_OFF>;
            label = "LAYER0LIGHT";
        };
    };

    behaviors {
        sensor_rotate: sensor_rotate {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SENSOR_ROTATE";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };

        mid_click: mid_click {
            compatible = "zmk,behavior-hold-tap";
            label = "MID_CLICK";
            bindings = <&mkp>, <&layer0light>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp TAB          &kp Q           &kp W          &kp E         &kp R         &kp T          &kp Y        &kp U          &kp I           &kp O    &kp P     &kp BSPC  &kp GRAVE
&kp CAPS         &kp A           &kp S          &kp D         &kp F         &kp G          &kp H        &kp J          &kp K           &kp L    &kp SEMI  &kp APOS  &lt 4 ENTER
&kp LSHFT        &kp Z           &kp X          &kp C         &kp V         &kp B          &kp N        &kp M          &kp COMMA       &kp DOT  &kp FSLH  &kp UP    &kp RSHFT
&mt LCTRL MINUS  &mt LGUI EQUAL  &kp BACKSPACE  &lt 2 ENTER   &mt LALT ESC  &lt 1 SPACE    &lt 1 SPACE  &mt RALT LBKT  &mt RCTRL RBKT  &kp ESC  &kp LEFT  &kp DOWN  &kp RIGHT
                                                &layer3light
            >;

            sensor-bindings = <&sensor_rotate>;
        };

        layer_1 {
            bindings = <
&trans       &kp N1      &kp N2        &kp N3        &kp N4  &kp N5    &trans  &trans  &trans  &kp KP_DIVIDE    &kp KP_N7     &kp KP_N8  &kp KP_N9
&trans       &kp N6      &kp N7        &kp N8        &kp N9  &kp N0    &trans  &trans  &trans  &kp KP_MULTIPLY  &kp KP_N4     &kp KP_N5  &kp KP_N6
&kp C_EJECT  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_DN  &trans  &trans    &trans  &trans  &trans  &kp KP_MINUS     &kp KP_N1     &kp KP_N2  &kp KP_N3
&trans       &trans      &trans        &trans        &trans  &trans    &trans  &trans  &trans  &kp KP_PLUS      &kp KP_ENTER  &kp KP_N0  &kp KP_DOT
                                       &kp C_MUTE
            >;

            label = "NUM";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans   &trans   &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
                          &trans
            >;

            label = "NAVI";
        };

        layer_3 {
            bindings = <
&trans  &trans     &trans             &trans             &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans             &trans             &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans             &trans             &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mkp LCLK  &mid_click MCLK 0  &mkp RCLK          &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                      &mid_click MCLK 0
            >;

            sensor-bindings = <&sensor_rotate>;
            label = "MOUSE";
        };

        layer_4 {
            bindings = <
&studio_unlock  &trans        &trans        &trans  &trans  &trans    &trans  &trans      &trans        &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans  &trans  &trans    &trans  &trans      &trans        &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans  &trans  &trans    &trans  &trans      &trans        &trans  &trans  &trans  &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &trans    &trans  &bt BT_CLR  &out OUT_TOG  &trans  &trans  &trans  &trans
                                            &trans
            >;

            label = "CONF";
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans
            >;
        };
    };
};
